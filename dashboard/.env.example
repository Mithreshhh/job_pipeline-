# ── Jobs dashboard ──
# Read-only view of the job pipeline's database. This app never writes, so use
# the read-only Atlas user (jobs_reader), never the pipeline's own credentials.

# On a machine whose DNS cannot resolve SRV records, use the long three-host
# form from Atlas -> Connect -> Drivers with the "SRV Connection String"
# toggle off. Vercel resolves SRV fine, so the +srv form is right in production.
MONGODB_URI=mongodb+srv://jobs_reader:<password>@cluster0.xxxxx.mongodb.net/jobboard

# Which database on that cluster. The pipeline writes to "jobboard".
MONGODB_DB=jobboard

# The single shared password for the dashboard. Until this is set, a built-in
# development password is in force and the UI says so on every page.
DASHBOARD_PASSWORD=

# Optional. Signs the session cookie; defaults to a key derived from the
# password, which means changing the password signs everyone out.
DASHBOARD_SESSION_SECRET=
